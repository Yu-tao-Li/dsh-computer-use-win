{
  "name": "dsh-computer-use-win",
  "version": "0.6.3",
  "description": "Windows computer use for DeepSeek Harness: an MCP stdio server + PowerShell UIA backend, bridged into DSH via @deepseek-ai/dsh-mcp-client. Read/act on real Windows desktop apps (UI Automation tree, screenshots, typed input, OCR, window management).",
  "type": "module",
  "bin": {
    "wcu-mcp": "mcp/server.mjs"
  },
  "main": "mcp/dsh-plugin.mjs",
  "files": [
    "mcp/activity.mjs",
    "mcp/background-desktop.mjs",
    "mcp/browser-bidi-dom.mjs",
    "mcp/browser-bidi.mjs",
    "mcp/browser-frames.mjs",
    "mcp/browser-pipe.mjs",
    "mcp/browser-profile-lock.mjs",
    "mcp/browser.mjs",
    "mcp/catalog.mjs",
    "mcp/diagnostics.mjs",
    "mcp/client.js",
    "mcp/dsh-plugin.mjs",
    "mcp/host-compat.mjs",
    "mcp/hyperv-relay.mjs",
    "mcp/overlay-strings.mjs",
    "mcp/page-values.mjs",
    "mcp/policy.mjs",
    "mcp/progress-summary.mjs",
    "mcp/protocol.mjs",
    "mcp/server.mjs",
    "mcp/settings-schema.mjs",
    "mcp/settings.mjs",
    "mcp/takeover.mjs",
    "scripts/windows-uia.ps1",
    "scripts/background-desktop.ps1",
    "scripts/hyperv-desktop.ps1",
    "scripts/windows-takeover.ps1",
    "scripts/windows-takeover.cs",
    "scripts/windows-clipboard.cs",
    "scripts/native-loader.ps1",
    "scripts/native/wcu-clipboard-netfx.dll",
    "scripts/native/wcu-native-netfx.dll",
    "scripts/native/wcu-ocr-netfx.dll",
    "scripts/native/wcu-takeover-netfx.dll",
    "scripts/native/manifest.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./mcp/dsh-plugin.mjs",
    "./client": "./mcp/client.js",
    "./mcp/server.mjs": "./mcp/server.mjs",
    "./mcp/dsh-plugin.mjs": "./mcp/dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "selftest": "node mcp/server.mjs --self-test",
    "mcp-test": "node test/mcp-test.mjs",
    "profile-resolution": "node test/profile-resolution.mjs",
    "test": "node test/run-tests.mjs",
    "e2e": "node test/notepad-e2e.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "prepack": "node scripts/check-build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:pack": "node scripts/check-build.mjs --pack",
    "build:native": "powershell.exe -NoProfile -File scripts/build-native.ps1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "computer-use",
    "windows",
    "uia",
    "desktop-automation"
  ],
  "author": "Yu-tao-Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yu-tao-Li/dsh-computer-use-win.git"
  },
  "bugs": {
    "url": "https://github.com/Yu-tao-Li/dsh-computer-use-win/issues"
  },
  "homepage": "https://github.com/Yu-tao-Li/dsh-computer-use-win#readme",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/client": "2.3.1",
    "electron": "44.0.0",
    "js-yaml": "4.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0 <0.3.0 || 0.1.0-rc.2 || 0.1.0-rc.6 || 0.1.0-rc.7 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
